# ============================================================================
# Variables d'environnement — copier vers .env.local (jamais commité)
# et reporter les mêmes valeurs dans Vercel (Project Settings > Environment
# Variables) pour le déploiement.
# ============================================================================

# --- Supabase : exposables au navigateur (protégées par RLS, SELECT seul) ---
NEXT_PUBLIC_SUPABASE_URL=https://nqmmazpiksmudmzqsxps.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KXeDQABpr_RbBy_MrlETRw_BKOYyVfR

# --- Supabase : SERVEUR UNIQUEMENT ---
# Clé service_role (Project Settings > API). Contourne RLS : ne JAMAIS la
# préfixer NEXT_PUBLIC_, ne jamais la commiter, ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Mot de passe d'administration (/admin) ---
# Vérifié côté serveur à chaque écriture (401 si absent ou faux).
ADMIN_PASSWORD=

# --- Verrou de démonstration sur la CONSULTATION (phase proposition) ---
# Tant que cette variable est définie, la page publique demande ce mot de
# passe. Le jour d'une validation Cerba : supprimer (ou vider) la variable,
# redéployer — la consultation devient publique sans autre changement.
DEMO_PASSWORD=
