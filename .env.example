# Supabase — projet en région UE (Frankfurt / eu-central-1)
# Project Settings > API  →  https://supabase.com/dashboard/project/<ref>/settings/api

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# anon / publishable key — exposable côté client (protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key — SERVEUR UNIQUEMENT.
# Contourne RLS. Ne jamais commiter, ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
